{
  "name": "junk-magnet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "zip": "npm run build && cd dist && rm -f ../junk-magnet.zip && zip -qr ../junk-magnet.zip .",
    "build:play": "npm run build && rm -rf play && cp -r dist play",
    "playtest": "node tools/playtest.cjs",
    "store-art": "node tools/store-art.cjs"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
